{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"]
    },
    "allowSyntheticDefaultImports": true,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.cache/tsconfig-node"
  },
  "include": ["vite.config.ts"]
}
